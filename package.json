{
  "name": "ai-stock-trading-analysis-web",
  "private": true,
  "description": "前端開發工具：esbuild 打包與 TypeScript 型別檢查（只有開發時需要；打包好的程式不依賴 node_modules）",
  "scripts": {
    "build": "python build_web.py --web",
    "dev": "python build_web.py --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint web"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
