@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================================
echo   股票交易分析系統 - 一鍵打包工具
echo ============================================================
echo 正在編譯更新 執行檔 (.exe) 與 安裝包 (_Setup.exe)...
echo 請稍候...
echo.

python build_app.py

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ============================================================
    echo [成功] 打包完成！產出檔案位於 dist 資料夾：
    echo   1. dist\股票交易分析系統.exe (免安裝單一執行檔)
    echo   2. dist\股票交易分析系統_Setup.exe (一鍵安裝包)
    echo ============================================================
) else (
    echo.
    echo [失敗] 打包過程發生錯誤，請檢查上方訊息。
)

echo.
pause
